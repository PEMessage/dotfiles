#!/bin/bash
LOCAL_SCRIPT_PATH="$(readlink -f $0)"
LOCAL_SCRIPT_DIR="$(dirname $LOCAL_SCRIPT_PATH)"

[ -d "$CONF_BUCKET_DIR" ] ||
    export CONF_BUCKET_DIR="$LOCAL_SCRIPT_DIR/bucket"

[ -d "$CONF_DBEUG" ] ||
    export CONF_DBEUG=false

usage() {
    echo "USAGE:"
    echo
    echo "-l: print all task list"
    echo "-h: print this help page"
    echo
    echo "CONF:"
    echo
    echo "CONF_BUCKET_DIR : $CONF_BUCKET_DIR"
    echo "CONF_DBEUG      : $CONF_DBEUG"
}

zsh_completion() {
    cat <<'EOF'
#compdef q-task

_q-task() {
    local -a commands tasks

    commands=(
        '-h:Show help'
        '-l:List all tasks'
        '--shell:Generate shell completion'
    )

    if [[ $words[2] == -* || $CURRENT -eq 2 ]]; then
        _describe 'command' commands
    else
        # Get task list from 'q-task -l' command
        tasks=(${(f)"$(q-task -l 2>/dev/null)"})
        _describe 'task' tasks
    fi
}

compdef _q-task q-task
EOF
}


main() {
    [ -n "$1" ] || {
        usage
        exit
    }

    case "$1" in
        -h)
            usage
            ;;
        -l)
            (
                cd "$CONF_BUCKET_DIR"
                find . -type f -name '*sh'
            )
            ;;
        --shell)
            case $2 in
                zsh) zsh_completion;;
                *);;
            esac
            ;;
        *)
            if [ ! -f "$CONF_BUCKET_DIR/$1" ] ; then
                echo "[Err]: Unknow task(file not exist)"
                echo "[Err]: use '-l' to check all task"
            fi
            Q_TASK_SCRIPT="$CONF_BUCKET_DIR/$1"
            shift
            bash "$Q_TASK_SCRIPT" "$@"
            ;;
    esac

}


main "$@"

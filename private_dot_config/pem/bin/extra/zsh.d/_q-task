#compdef q-task

local -a commands tasks

commands=(
    '-h:Show help'
    '-l:List all tasks'
    '-e:Edit tasks'
)

task=""


get_task() {
    if [ -z "$task" ] ; then
        tasks=(${(f)"$(q-task -l 2>/dev/null)"})
    fi
}

case $CURRENT in
    2) 
        if [[ $words[2] == -* ]]; then
            _describe 'command' commands
        else
            # Get task list from 'q-task -l' command
            get_task
            _describe 'task' tasks
        fi
    ;;
    3)
        if [[ $words[2] == -e ]]; then
            get_task
            _describe 'task' tasks
        fi
    ;;
    *)
        _files
    ;;
esac

#compdef merge-json
#
# See: https://gemini.google.com/share/8ca202271cf4
# Maybe also: https://gemini.google.com/share/cafff2e98b41

local -a commands
local preset_path

# Get the base path where presets are stored
preset_path=$(merge-json --preset-path 2>/dev/null)

commands=(
    '-h:Show help'
    '-l:List all presets'
    '-e:Edit presets'
)

# Offer options only while the current argument starts with '-'
if [[ $words[CURRENT] == -* ]]; then
    _describe 'command' commands
    return
fi

# For any argument not starting with '-', complete presets and files
_alternative \
    "presets:preset:_path_files -W ${preset_path} -g '*(/)' -g '*.json' " \
    'files:file:_files'
return

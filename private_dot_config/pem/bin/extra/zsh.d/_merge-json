#compdef merge-json
#
# See: https://gemini.google.com/share/8ca202271cf4
# Maybe also: https://gemini.google.com/share/cafff2e98b41

local -a commands
local preset_path

# Get the base path where presets are stored
preset_path=$(merge-json --preset-path 2>/dev/null)

commands=(
    '-h:Show help'
    '-l:List all presets'
    '-e:Edit presets'
)

# Handle command completion for first argument
if [[ $CURRENT -eq 2 && $words[2] == -* ]]; then
    _describe 'command' commands
    return
fi

# Handle preset completion for -e option or default arguments
if [[ $CURRENT -eq 3 && $words[2] == -e ]] || [[ $CURRENT -eq 2 && $words[2] != -* ]]; then
    _alternative \
        "presets:preset:_path_files -W ${preset_path} -g '*(/)' -g '*.json' " \
        'files:file:_files'
    return
fi

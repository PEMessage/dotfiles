#!/bin/bash

# GitHub Auto-Update Download Script with jq parsing
# Usage: ./github_updater.sh <owner> <repo> <asset_pattern> [<output_file>]

set -euo pipefail

# Global variables
RELEASE_DATA=""
LATEST_VERSION=""
ASSET_URL=""
OUTPUT_FILE=""
runcmd() {
    echo "Runing: $*"
    "$@"
}

# Check if required commands are available
check_dependencies() {
    local missing=()
    for cmd in curl jq; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo "[Err]: Missing required commands: ${missing[*]}"
        echo "[Err]: Please install them before running this script."
        exit 1
    fi
}

# Get the latest release data from GitHub API
fetch_release_data() {
    local repo="$1"
    local api_url="https://api.github.com/repos/${repo}/releases/latest"

    echo "[Info]: Fetching release data from GitHub... "
    echo "[Info]: Runing: RELEASE_DATA=\"\$(curl -sL \"$api_url\")\""
    RELEASE_DATA="$(curl -sL "$api_url")"
}

# Extract the latest version tag
get_latest_version() {
    LATEST_VERSION=$(echo "$RELEASE_DATA" | jq -r '.tag_name')
    echo "[Info]: Latest version found: $LATEST_VERSION"
}

# Find the asset URL that matches our pattern
find_asset_url() {
    local pattern="$1"
    
    # NOTE: !!! using `echo "$VAR" | jq` will case some bug
    ASSET_URL=$( jq -r --arg pattern "$pattern" \
        '.assets[] | select(.name | match($pattern)) | .browser_download_url' <<< "$RELEASE_DATA" ) 

    if [ "$(echo "${ASSET_URL}" | wc -l)" -gt 1 ] ; then
        echo "[Err]: More than one asset matching pattern '$pattern'"
        exit 1
    fi
    if [ -z "$ASSET_URL" ]; then
        echo "[Err]: Could not find asset matching pattern '$pattern'"
        exit 1
    fi
}

# Determine the output filename
set_output_filename() {
    if [ -z "$suggested_output" ] ; then
        OUTPUT_FILE=$(basename "$ASSET_URL")
    else
        OUTPUT_FILE="$suggested_output"
    fi
    echo "[Info]: Output file will be: $OUTPUT_FILE"
}

# Download the asset
download_asset() {
    echo "[Info]: Downloading: ..."
    runcmd curl -# -L -o "$OUTPUT_FILE" "$ASSET_URL"
}



# Main control function
main() {
    check_dependencies

    if [ $# -lt 3 ]; then
        echo "Usage: $0 <owner>/<repo> <asset_pattern> [<output_file>]"
        echo "Example: $0 neovim neovim-releases 'nvim-linux-x86_64.appimage' nvim.appimage"
        exit 1
    fi

    local repo="$1"
    local asset_pattern="$2"
    local suggested_output="${3:-}"

    fetch_release_data "$repo"
    get_latest_version
    find_asset_url "$asset_pattern"
    set_output_filename
    download_asset

    echo "Download completed successfully"
    echo "File saved to: $(pwd)/$OUTPUT_FILE"
    echo "Version: $LATEST_VERSION"
}

main "$@"

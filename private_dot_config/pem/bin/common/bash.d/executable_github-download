#!/bin/bash

# GitHub Auto-Update Download Script with jq and archive extraction support
# Usage: ./github_updater.sh [-f] <repo_owner>/<repo_name> <asset_pattern> [<output_file|archive_path:final_file>]

set -eo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m' # No Color

# Initialize variables
FORCE=false
EXTRACT_MODE=false
ARCHIVE_PATH=""
FINAL_FILE=""

# -------------------------------
# Function Definitions
# -------------------------------

# Print usage information
usage() {
    echo -e "${RED}Usage:${NC} $0 [-f] <repo_owner>/<repo_name> <asset_pattern> [<output_file|archive_path:final_file>]"
    echo -e "${GREEN}Examples:${NC}"
    echo -e "  $0 -f neovim/neovim-releases 'nvim-linux64.tar.gz'"
    echo -e "  $0 neovim/neovim-releases 'nvim-linux64.tar.gz' nvim.tar.gz"
    echo -e "  $0 neovim/neovim-releases 'nvim-linux64.tar.gz' 'bin/nvim:/usr/local/bin/nvim'"
    echo -e "${YELLOW}Requires:${NC} curl, jq, tar, unzip"
    exit 1
}

# Check for required commands
check_requirements() {
    local required=("curl" "jq" "tar" "unzip")
    for cmd in "${required[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || { 
            echo -e "${RED}Error: $cmd is required${NC}"
            exit 1
        }
    done
}

# Parse output file specification for extract mode
parse_output_spec() {
    local spec="$1"
    if [[ "$spec" == *":"* ]]; then
        EXTRACT_MODE=true
        ARCHIVE_PATH=$(echo "$spec" | cut -d':' -f1)
        FINAL_FILE=$(echo "$spec" | cut -d':' -f2)
        echo -e "${BLUE}│ Extract Mode:  ${GREEN}Yes${NC}"
        echo -e "${BLUE}│ Archive Path:  ${GREEN}${ARCHIVE_PATH}${NC}"
        echo -e "${BLUE}│ Final File:    ${GREEN}${FINAL_FILE}${NC}"
        
        # Create temp directory
        TEMP_DIR=$(mktemp -d)
        trap 'rm -rf "$TEMP_DIR"' EXIT
    fi
}

# Get release information from GitHub API
get_release_info() {
    local repo="$1"
    API_URL="https://api.github.com/repos/${repo}/releases/latest"
    echo -e "${BLUE}┌──────────────────────────────────────────────────────┐${NC}"
    echo -e "${BLUE}│ ${YELLOW}Fetching release info from GitHub...${NC}"
    echo -e "${BLUE}│ API URL: ${GREEN}${API_URL}${NC}"
    
    RELEASE_JSON=$(curl -sL "$API_URL")
    LATEST_VERSION=$(echo "$RELEASE_JSON" | jq -r '.tag_name')
    echo -e "${BLUE}│ Latest Tag: ${GREEN}${LATEST_VERSION}${NC}"
}

# Find matching assets
find_matching_assets() {
    local pattern="$1"
    MATCHING_ASSETS=$(echo "$RELEASE_JSON" | jq -r --arg pattern "$pattern" '[.assets[] | select(.name | test($pattern))]')
    ASSET_COUNT=$(echo "$MATCHING_ASSETS" | jq 'length')
    
    if [ "$ASSET_COUNT" -eq 0 ]; then
        echo -e "${BLUE}└──────────────────────────────────────────────────────┘${NC}"
        echo -e "${RED}Error: No assets found matching pattern '${pattern}'${NC}"
        echo -e "${YELLOW}Available assets:${NC}"
        echo "$RELEASE_JSON" | jq -r '.assets[].name' | sed 's/^/ - /'
        exit 1
    elif [ "$ASSET_COUNT" -gt 1 ]; then
        echo -e "${BLUE}└──────────────────────────────────────────────────────┘${NC}"
        echo -e "${RED}Error: Found ${ASSET_COUNT} assets matching pattern '${pattern}'${NC}"
        echo -e "${YELLOW}Matching assets:${NC}"
        echo "$MATCHING_ASSETS" | jq -r '.[].name' | sed 's/^/ - /'
        echo -e "\n${YELLOW}Please refine your pattern to match exactly one asset.${NC}"
        exit 1
    fi
    
    ASSET_INFO=$(echo "$MATCHING_ASSETS" | jq '.[0]')
    ASSET_NAME=$(echo "$ASSET_INFO" | jq -r '.name')
    ASSET_URL=$(echo "$ASSET_INFO" | jq -r '.browser_download_url')
    DOWNLOAD_COUNT=$(echo "$ASSET_INFO" | jq -r '.download_count')
    SIZE_BYTES=$(echo "$ASSET_INFO" | jq -r '.size')
    SIZE_MB=$(awk "BEGIN {printf \"%.1f\", $SIZE_BYTES/1024/1024}")
    CREATED_AT=$(echo "$ASSET_INFO" | jq -r '.created_at' | cut -d'T' -f1)
    
    echo -e "${BLUE}│ Asset Name:    ${GREEN}${ASSET_NAME}${NC}"
    echo -e "${BLUE}│ Download URL:  ${YELLOW}${ASSET_URL}${NC}"
    echo -e "${BLUE}│ Created:       ${GREEN}${CREATED_AT}${NC}"
    echo -e "${BLUE}│ Downloads:     ${GREEN}${DOWNLOAD_COUNT}${NC}"
    echo -e "${BLUE}│ Size:          ${GREEN}${SIZE_MB} MB${NC}"
}

# Handle existing file
handle_existing_file() {
    local file="$1"
    if [ -f "$file" ]; then
        if [ "$FORCE" = true ]; then
            echo -e "${YELLOW}Warning: Overwriting existing file '${file}'${NC}"
        else
            echo -e "${YELLOW}Warning: File '${file}' already exists${NC}"
            read -p "Overwrite? (y/N) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo -e "${RED}Download canceled${NC}"
                exit 0
            fi
        fi
    fi
}

# Confirm download with user
confirm_download() {
    local url="$1"
    local file="$2"
    local size="$3"
    
    if [ "$FORCE" = false ]; then
        echo -e "\n${BLUE}About to download:${NC}"
        echo -e " - From: ${YELLOW}${url}${NC}"
        echo -e " - To:   ${GREEN}${file}${NC}"
        echo -e " - Size: ${GREEN}${size} MB${NC}"

        read -p "Proceed with download? (Y/n) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Nn]$ ]]; then
            echo -e "${RED}Download canceled${NC}"
            exit 0
        fi
    fi
}

# Download the asset
download_asset() {
    local url="$1"
    local output="$2"
    
    echo -e "${BLUE}Downloading...${NC}"
    echo curl '-#' -L -o "$output" "$url"
    curl -# -L -o "$output" "$url"
}

# Extract file from archive
extract_from_archive() {
    local archive="$1"
    local path="$2"
    local output="$3"
    
    echo -e "${BLUE}Extracting ${path} from $archive...${NC}"
    
    if [[ "$archive" == *.zip ]]; then
        unzip -p "$archive" "$path" > "$output"
    elif [[ "$archive" == *.tar* ]]; then
        tar -xf "$archive" -O "$path" > "$output"
    else
        echo -e "${RED}Error: Unsupported archive format${NC}"
        exit 1
    fi
    chmod a+x "$output"
    rm -rf "$archive"
    
}

# -------------------------------
# Main Script Execution
# -------------------------------

# Parse command line options
while getopts "f" opt; do
  case $opt in
    f) FORCE=true ;;
    *) usage ;;
  esac
done
shift $((OPTIND -1))

# Validate arguments
if [ $# -lt 2 ]; then
    usage
fi

REPO="$1"
ASSET_PATTERN="$2"
OUTPUT_SPEC="${3:-}"

# Check requirements
check_requirements

# # Parse output specification if provided
if [ -n "$OUTPUT_SPEC" ]; then
    parse_output_spec "$OUTPUT_SPEC"
fi

# Get release information
get_release_info "$REPO"

# Find matching assets
find_matching_assets "$ASSET_PATTERN"

# Determine output filename
if [ -z "$OUTPUT_SPEC" ]; then
    OUTPUT_FILE="$ASSET_NAME"
elif [ "$EXTRACT_MODE" = true ]; then
    OUTPUT_FILE="$ASSET_NAME"
else
    OUTPUT_FILE="$OUTPUT_SPEC"
fi

# Handle existing file
handle_existing_file "$OUTPUT_FILE"

# Confirm download
confirm_download "$ASSET_URL" "$ASSET_NAME" "$SIZE_MB"

# Download the asset
download_asset "$ASSET_URL" "$ASSET_NAME"

# Handle extraction if needed
if [ "$EXTRACT_MODE" = true ]; then
    extract_from_archive "$ASSET_NAME" "$ARCHIVE_PATH" "$FINAL_FILE"
    echo -e "${BLUE}└──────────────────────────────────────────────────────┘${NC}"
    echo -e "${GREEN} Extraction completed successfully${NC}"
    echo -e "File saved as: ${GREEN}${FINAL_FILE}${NC}"
else
    # Make executable if it's an AppImage or binary
    chmod +x "$OUTPUT_FILE"
    echo -e "${GREEN}Made executable: ${OUTPUT_FILE}${NC}"
    
    echo -e "${BLUE}└──────────────────────────────────────────────────────┘${NC}"
    echo -e "${GREEN} Download completed successfully${NC}"
    echo -e "File saved as: ${GREEN}${OUTPUT_FILE}${NC}"
fi

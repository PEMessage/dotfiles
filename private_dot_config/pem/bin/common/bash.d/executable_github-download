#!/usr/bin/env bash

# GitHub Auto-Update Download Script with jq parsing
# Usage: ./github_updater.sh <owner>/<repo> <asset_pattern> [<output_file>] [-v VERSION] [--no-download]

set -euo pipefail

# Global variables
RELEASE_DATA=""
SELECTED_VERSION="latest"
ASSET_URL=""
OUTPUT_FILE=""
GH_AUTH_AVAILABLE=false
NO_DOWNLOAD=false

runcmd() {
    echo "Runing: $*"
    "$@"
}

# Check if required commands are available
check_dependencies() {
    local missing=()
    for cmd in curl jq; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        echo "[Err]: Missing required commands: ${missing[*]}"
        echo "[Err]: Please install them before running this script."
        exit 1
    fi
}

# Check if GitHub CLI is authenticated
check_auth() {
    if ! command -v gh &> /dev/null; then
        echo "[Info]: GitHub CLI (gh) not found, using unauthenticated API (may have rate limits)"
        GH_AUTH_AVAILABLE=false
        return
    fi

    local auth_status
    auth_status=$(gh auth status --json hosts 2>/dev/null) || {
        echo "[Info]: GitHub CLI not authenticated, using unauthenticated API (may have rate limits)"
        GH_AUTH_AVAILABLE=false
        return
    } && {
        echo "[Info]: gh auth status --json hosts"
    }

    # Check if we have a successful authentication for github.com
    local github_auth
    github_auth=$(jq -r '.hosts["github.com"] | select(. != null) | .[0].state' <<< "$auth_status" 2>/dev/null)

    if [ "$github_auth" = "success" ]; then
        local login
        login=$(jq -r '.hosts["github.com"][0].login' <<< "$auth_status")
        echo "[Info]: GitHub CLI authenticated as: $login"
        GH_AUTH_AVAILABLE=true
    else
        echo "[Info]: GitHub CLI not authenticated for github.com, using unauthenticated API (may have rate limits)"
        GH_AUTH_AVAILABLE=false
    fi
}

# Get release data from GitHub API (dual-stack: gh CLI or curl)
fetch_release_data() {
    local repo="$1"
    local version="$2"
    local api_endpoint
    
    if [ "${version}" = latest ] ; then
        api_endpoint="repos/${repo}/releases/latest"
    else
        api_endpoint="repos/${repo}/releases/tags/${version}"
    fi
    
    # Try authenticated gh CLI first if available
    if [ "$GH_AUTH_AVAILABLE" = true ]; then
        echo "[Info]: Fetching release data for version $version using gh CLI..."
        echo "[Info]: Runing: gh api \"${api_endpoint}\""
        
        RELEASE_DATA=$(gh api "${api_endpoint}" 2>&1) || {
            echo "[Err]: Failed to fetch release data via gh CLI"
            echo "[Err]: $RELEASE_DATA"
            exit 1
        }
    else
        # Fallback to unauthenticated curl
        local api_url="https://api.github.com/${api_endpoint}"
        echo "[Info]: Fetching release data for version $version from GitHub (unauthenticated)..."
        echo "[Info]: Runing: curl -sL \"$api_url\""
        
        RELEASE_DATA="$(curl -sL "$api_url")"
    fi
    
    # Check if release data was fetched successfully
    if [[ $(jq -r '.message // empty' <<< "$RELEASE_DATA") == "Not Found" ]]; then
        echo "[Err]: Release not found - ${api_endpoint}"
        exit 1
    fi
}

# Extract the version tag
get_version() {
    SELECTED_VERSION=$(jq -r '.tag_name' <<< "$RELEASE_DATA")
    echo "[Info]: Selected version: $SELECTED_VERSION"
}

# Find the asset URL that matches our pattern
find_asset_url() {
    local pattern="$1"
    
    # NOTE: !!! using `echo "$VAR" | jq` will case some bug
    ASSET_URL=$(jq -r --arg pattern "$pattern" \
        '.assets[] | select(.name | match($pattern)) | .browser_download_url' <<< "$RELEASE_DATA" )

    if [ "$(echo "${ASSET_URL}" | wc -l)" -gt 1 ] ; then
        echo "[Err]: More than one asset matching pattern '$pattern'"
        exit 1
    fi

    if [ -z "$ASSET_URL" ]; then
        echo "[Err]: Could not find asset matching pattern '$pattern'"
        exit 1
    fi
    
}

# Determine the output filename
set_output_filename() {
    if [ -z "$suggested_output" ] ; then
        OUTPUT_FILE=$(basename "$ASSET_URL")
    else
        OUTPUT_FILE="$suggested_output"
    fi
    echo "[Info]: Output file will be: $OUTPUT_FILE"
}

# Download the asset
download_asset() {
    echo "[Info]: Downloading: ..."
    runcmd curl -# -L -o "$OUTPUT_FILE" "$ASSET_URL"
}

# Parse command line arguments
parse_arguments() {
    local positional=()
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -v|--version)
                SELECTED_VERSION="$2"
                shift 2
                ;;
            --no-download)
                NO_DOWNLOAD=true
                shift
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done
    
    # Restore positional parameters
    set -- "${positional[@]}"
    
    if [ $# -lt 2 ]; then
        echo "Usage: $0 <owner>/<repo> <asset_pattern> [<output_file>] [-v VERSION] [--no-download]"
        echo "Example: $0 neovim/neovim 'nvim-linux64.tar.gz' nvim.tar.gz -v v0.9.0"
        echo "Example: $0 neovim/neovim 'nvim-linux64.tar.gz' # Uses latest version"
        echo "Example: $0 neovim/neovim 'nvim-linux64.tar.gz' --no-download # Check only, no download"
        exit 1
    fi
    
    repo="$1"
    asset_pattern="$2"
    suggested_output="${3:-}"
}

# Main control function
main() {
    check_dependencies
    check_auth
    parse_arguments "$@"
    
    fetch_release_data "$repo" "$SELECTED_VERSION"
    get_version
    find_asset_url "$asset_pattern"
    set_output_filename
    
    if [ "$NO_DOWNLOAD" = true ]; then
        echo "[Info]: --no-download specified, skipping download"
        echo "Would download: $ASSET_URL"
        echo "Save to: $(pwd)/$OUTPUT_FILE"
        echo "Version: $SELECTED_VERSION"
        exit 0
    fi
    
    download_asset

    echo "Download completed successfully"
    echo "File saved to: $(pwd)/$OUTPUT_FILE"
    echo "Version: $SELECTED_VERSION"
}

main "$@"

#!/bin/bash

select_from() {
  local c
  for c; do
    if command -v "${c%% *}" &> /dev/null; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

extra_args() {
    [ -z "$EDITOR" ] && EDITOR=vim
    [[ "$EDITOR" =~ ^.*vi.*$ ]] && EDITOR_EXTRARG='+{2}' # for line number
}

# Parse arguments
pass_through_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --)
            shift
            pass_through_args+=("$@") # append to it
            break
            ;;
        # bool parameter 
        -i)
            pass_through_args+=("'$1'")
            shift
            ;;
        # single value parameter
        -g)
            pass_through_args+=("'$1'")
            shift
            pass_through_args+=("'$1'")
            shift
            ;;
        *)
            query="$1"
            shift
            ;;
    esac
done

preview=$(select_from 'bat --color=always --style=header,numbers -H {2} {1}' \
    'awk "BEGIN{a=\"'"{2}"'\";gsub(\"'"'"'\", \"\", a)} NR==(a+0){print \"\033[1;31m\" \$0 \"\033[0m\"; next} {print}" {1}' \
    'cat {1}')

extra_args

command=$(select_from "rg -n --color=always ${pass_through_args[*]}" 'grep -Rn --color=always')

fzf -d: \
    --ansi \
    --query="${query:-}" \
    --phony \
    --bind="change:reload:$command {q}" \
    --bind="start:reload:$command {q}" \
    --bind="ctrl-r:reload:$command {q}" \
    --bind="enter:execute:$EDITOR {1} $EDITOR_EXTRARG" \
    --preview-window='up:+{2}-/2' \
    --preview="[[ -n {1} ]] && $preview"

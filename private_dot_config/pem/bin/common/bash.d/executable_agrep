#!/bin/bash

# set -x
# Check if output is a TTY for color support
if [ -t 1 ]; then
    # Terminal colors
    RED=$(printf '\033[1;31m')
    GREEN=$(printf '\033[0;32m')
    BLUE=$(printf '\033[1;34m')
    PURPLE=$(printf '\033[0;35m')
    NC=$(printf '\033[0m') # No Color

    # Apply colors to different elements
    PATH_COLOR="$PURPLE"
    COLON_COLOR="$BLUE"
    LINE_COLOR="$GREEN"
    MATCH_COLOR="$RED"
else
    # No colors for non-TTY output
    RED=''
    GREEN=''
    BLUE=''
    PURPLE=''
    NC=''
    PATH_COLOR=''
    COLON_COLOR=''
    LINE_COLOR=''
    MATCH_COLOR=''
fi


mode=""
ignore_case=""
globs=()
regex=""
others=()

for ((i=1; i<=$#; i++)); do
    arg="${!i}"

    if [[ -z "$mode" && ( "$arg" == -t || "$arg" == -f || "$arg" = -c ) ]]; then
        mode="$arg"
    elif [[ $arg = "-i" ]]; then
        ignore_case=1
    elif [[ $arg = "-g" ]]; then
        ((i++))
        globs=("--globs" "${!i}")
    elif [[ -z "$regex" ]]; then
        regex="$arg"
    else
        others+=("$arg")
    fi
done

if [ "$ignore_case" = 1 ] ; then
    regex="(?i)$regex"
fi
    

FUNC_INLINE_RULE='
---
id: find-fun-cpp
language: cpp
rule:
  kind: function_declarator
  inside:
    kind: function_definition
  regex: '$regex'
---
id: find-func-c
language: c
rule:
  kind: function_declarator
  inside:
    kind: function_definition
  regex: '$regex'
'

TYPE_INLINE_RULE='
---
id: find-type-cpp
language: cpp
rule:
  kind: type_identifier
  inside:
    any:
      - kind: class_specifier
      - kind: struct_specifier
      - kind: enum_specifier
  regex: '$regex'
---
id: find-type-c
language: c
rule:
  kind: type_identifier
  inside:
    any:
      - kind: struct_specifier
      - kind: enum_specifier
  regex: '$regex'
'

CALL_INLINE_RULE='
---
id: find-call-cpp
language: cpp
rule:
  kind: call_expression
  regex: '$regex'
---
id: find-call-c
language: c
rule:
  kind: call_expression
  regex: '$regex'
'


case "$mode" in
    -f) INLINE_RULE="$FUNC_INLINE_RULE"
    ;;
    -t) INLINE_RULE="$TYPE_INLINE_RULE"
    ;;
    -c) INLINE_RULE="$CALL_INLINE_RULE"
    ;;
    *) INLINE_RULE="$FUNC_INLINE_RULE"
    ;;
esac



FORMATTER='. | '
FORMATTER+='.lines as $lines | ($lines|length) as $total |'
FORMATTER+='"'
FORMATTER+='\($path_color)\(.file)\($nc)'
FORMATTER+='\($colon_color):\($nc)'
FORMATTER+='\($line_color)\(.range.start.line)\($nc)'
FORMATTER+='\($colon_color):\($nc)'
FORMATTER+='\($line_color)\(.range.start.column)\($nc)'
FORMATTER+='\($colon_color):\($nc)'

# 1. Just match Text
# FORMATTER+='\($match_color)\(.text)\($nc)'
# FORMATTER+='"'
#
# 2. A little context
# FORMATTER+='\(.lines[0:.range.start.column])'
# FORMATTER+='\($match_color)\(.lines[.range.start.column:.range.end.column])\($nc)'
# FORMATTER+='\(.lines[.range.end.column:])'
# FORMATTER+='"'
#
# 3. try to deal with multiline
# FORMATTER+='\(.lines[0:.charCount.leading])'
# FORMATTER+='\($match_color)\(.lines[.charCount.leading:-.charCount.trailing])\($nc)'
# FORMATTER+='\(.lines[-.charCount.trailing:])'
# FORMATTER+='"'
#
# 4. Deal with charCount.trailing is zero
FORMATTER+='\($lines[0:.charCount.leading])'
FORMATTER+='\($match_color)\($lines[.charCount.leading:$total-.charCount.trailing])\($nc)'
FORMATTER+='\($lines[$total-.charCount.trailing:])'
FORMATTER+='"'

# ast-grep scan "${globs[@]}" --json=stream --inline-rules "$INLINE_RULE" "${others[@]}"
ast-grep scan "${globs[@]}" --json=stream --inline-rules "$INLINE_RULE" "${others[@]}" |
     jq \
        --arg path_color "$PURPLE" \
        --arg colon_color "$BLUE" \
        --arg line_color "$GREEN" \
        --arg match_color "$RED" \
        --arg nc "$NC" \
        -r "$FORMATTER"

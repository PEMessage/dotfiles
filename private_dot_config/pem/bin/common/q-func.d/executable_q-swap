#!/bin/bash

show_usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] <file1> <file2>
       $(basename "$0") [OPTIONS] --bak <filename>

Swap the contents of two files.

OPTIONS:
  -b, --bak     Swap file with its .bak version (e.g., file.txt <-> file.txt.bak)
  -h, --help    Show this help message

EXAMPLES:
  $(basename "$0") file1.txt file2.txt    # Swap two files
  $(basename "$0") -b config.conf         # Swap config.conf with config.conf.bak
  $(basename "$0") --bak notes.md         # Swap notes.md with notes.md.bak
EOF
}

# Function to swap two files
swap_files() {
    local file1="$1"
    local file2="$2"
    local tmpfile="/tmp/swap_temp.$$"

    # Check if both arguments are provided
    if [[ -z "$file1" || -z "$file2" ]]; then
        echo "Error: Both filenames are required" >&2
        return 1
    fi

    # Check if both files exist
    if [[ ! -e "$file1" && ! -e "$file2" ]]; then
        echo "Error: Neither '$file1' nor '$file2' exist." >&2
        return 1
    fi

    # If file1 doesn't exist but file2 does, create empty file1
    if [[ ! -e "$file1" && -e "$file2" ]]; then
        echo "Warning: '$file1' does not exist. Creating empty file." >&2
        touch "$file1"
    fi

    # If file2 doesn't exist but file1 does, create empty file2
    if [[ -e "$file1" && ! -e "$file2" ]]; then
        echo "Warning: '$file2' does not exist. Creating empty file." >&2
        touch "$file2"
    fi

    # Both files exist now, perform the swap
    mv "$file1" "$tmpfile"
    mv "$file2" "$file1"
    mv "$tmpfile" "$file2"

    echo "Swapped: '$file1' <-> '$file2'"
    return 0
}

# Function to swap file with its .bak version (now using swap_files)
swap_with_bak() {
    local file="$1"
    local bakfile="${file}.bak"

    # Let swap_files handle the swapping logic
    swap_files "$file" "$bakfile"
}


# Parse arguments
bak_mode=false
files=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--bak)
            bak_mode=true
            shift
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        --)
            # End of options
            shift
            while [[ $# -gt 0 ]]; do
                files+=("$1")
                shift
            done
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            show_usage
            exit 1
            ;;
        *)
            # Regular argument (filename)
            files+=("$1")
            shift
            ;;
    esac
done

# Validate arguments based on mode
if [ ${#files[@]} -eq 0 ]; then
    show_usage
    exit 1
elif [ "$bak_mode" = true ]; then
    # Bak mode: exactly one filename
    if [ ${#files[@]} -ne 1 ]; then
        echo "Error: --bak mode requires exactly one filename" >&2
        echo "Usage: $(basename "$0") --bak <filename>" >&2
        exit 1
    fi
    swap_with_bak "${files[0]}"
    exit $?
else
    # Default swap mode: exactly two filenames
    if [ ${#files[@]} -ne 2 ]; then
        echo "Error: Default mode requires exactly two filenames" >&2
        echo "Usage: $(basename "$0") <file1> <file2>" >&2
        exit 1
    fi
    swap_files "${files[0]}" "${files[1]}"
    exit $?
fi


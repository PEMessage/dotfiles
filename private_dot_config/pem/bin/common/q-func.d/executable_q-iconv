#!/usr/bin/env bash

set -e

q_iconv() {
    if [ ! -f "$1" ] ; then
        echo "Err: not a filepath"
        return 1
    fi

    local origin_locale="$(uchardet "$1")"
    if [ "$origin_locale" = ASCII ] || 
        [ "$origin_locale" = 'UTF-8' ] ;then
        return 0
    fi
    if [ "$origin_locale" = GB18030 ] ; then 
        # Some GB18030 will cause iconv fail, so using GB2312
        origin_locale=GB2312
    fi

    cp -a "$1" "$1.bak"
    echo cp -a "$1" "$1.bak"

    echo iconv -f "$origin_locale" -t UTF-8 "$1.bak"  '>' "$1"
    iconv -f "$origin_locale" -t UTF-8 "$1.bak"  > "$1"
}

for x in "$@"
do
    q_iconv "$x"
done

#!/bin/bash

DRYRUN=0

runcmd() {
    if [ "$DRYRUN" == 1 ] ; then
        echo "$@"
    else
        "$@"
    fi
}
q_extract() {
    # Usage help
    if [ $# -eq 0 ]; then
        echo "Usage:"
        echo "  Extract all: q-extract archive"
        echo "  Extract specific files: q-extract archive [path1:output1] [path2:output2 ...]"
        echo "  Preview contents: q-extract --list archive"
        return 1
    fi

    local archive
    local action="extract_all"
    local filelists=()
    local other_args=()
    local executable=false

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -p)
                DRYRUN=1
                shift
                ;;
            --list|-l)
                action="list"
                list_flag=1
                shift
                ;;
            -x)
                executable=true
                shift
                ;;
            *)
                other_args+=("$1")
                shift
                ;;
        esac
    done
    set -- "${other_args[@]}"

    # Second pass: handle archive and file lists
    archive="$1"
    shift
    [ -f "$archive" ] || {
        echo "'$archive' is not a valid file!"
        return 1
    }

    if [[ "$action" != "list" && "$#" -gt 0 ]]; then
        action="extract_one"
        filelists=("$@")
    fi



    # 1. Determine file type and select binary + base arguments
    local bin
    local args
    case "$archive" in
        *.tar.bz2|*.tbz2)  bin="tar"; args=(-j) ;;
        *.tar.gz|*.tgz)     bin="tar"; args=(-z) ;;
        *.tar.xz)           bin="tar"; args=(-J) ;;
        *.tar.zst)          bin="tar"; args=(--use-compress-program='zstd -d') ;;
        *.tar)              bin="tar"; args=() ;;
        *.zip)             bin="unzip"; args=() ;;
        *.rar)             bin="rar"; args=(x) ;;
        *.7z)              bin="7z"; args=(x) ;;
        *.bz2)             bin="bunzip2"; args=() ;;
        *.gz)              bin="gunzip"; args=() ;;
        *.Z)               bin="uncompress"; args=() ;;
        *.zst)             bin="zstd"; args=(-d) ;;
        *.xz)             bin="unxz"; args=() ;;
        *)                 echo "Unsupported archive type: '$archive'"; return 1 ;;
    esac

    # 2. Handle different actions
    case "$action" in
        extract_all)
            case "$bin" in
                tar)    runcmd "$bin" "${args[@]}" -xvf "$archive" ;;
                unzip)  runcmd "$bin" "$archive" ;;
                rar|7z) runcmd "$bin" "${args[@]}" "$archive" ;;
                *)      runcmd "$bin" "${args[@]}" "$archive" ;;
            esac
            ;;

        extract_one)
            for arg in "${filelists[@]}"; do
                path="${arg%:*}"  # Remove everything after last :
                output="${arg#*:}" # Remove everything before first :
                
                [ -z "$output" ] && { echo "Invalid format: '$arg'. Use 'path:output'"; continue; }

                case "$bin" in
                    tar)
                        runcmd "$bin" "${args[@]}" -xf  "$archive" -O "$path" > "$output"
                        ;;
                    unzip)
                        runcmd "$bin" -p "$archive" "$path" > "$output"
                        ;;
                    *)
                        echo "Selective extraction not supported for $bin"
                        return 1
                        ;;
                esac
                if [ "$executable" = true ] ; then
                    chmod a+x "$output"
                fi
            done
            ;;

        list)
            case "$bin" in
                tar)    runcmd "$bin" "${args[@]}" -tf "$archive" ;;
                unzip)  runcmd "$bin" -l "$archive" ;;
                rar)    runcmd "$bin" v "$archive" ;;
                7z)     runcmd "$bin" l "$archive" ;;
                xz)     runcmd "$bin" -l "$archive" ;;
                *)      echo "Listing not supported for $bin"; return 1 ;;
            esac
            ;;

        *)
            echo "Unknown action: $action"
            return 1
            ;;
    esac
}

q_extract "$@"

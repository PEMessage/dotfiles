#!/bin/bash
# quick gcc - Compiles C/C++ code and runs the output
# Default output: filename_prefix.out (e.g., hello.c -> hello.out)
# Usage: ./q-gcc source_file [compiler_flags] -- [program_args]

# Extract source file (first argument)
if [ "$1" = clean ] ; then 
    echo rm -if *.out
    rm -if *.out
    exit 0
fi

first_args="$1"
shift  # Remove source file from arguments list
echo "$@"

if [ "$first_args" = "INTERNAL_CALL" ] ; then
    source_file="$1"
    shift
elif [ -f "$first_args" ] ; then
    head10="$(head -n10 "$first_args" | grep '//.*q-gcc' | cut -d : -f 2-)"
    echo "$head10"
    source_file="$first_args"
    if [ -n "$head10" ] ; then
        $0 INTERNAL_CALL $source_file $head10 "$@"
        exit $?
    fi
else
    echo "Unknow file"
    exit 1
fi


if [ -t 1 ] ; then
    greenF="\e[1;32m"
    resetFB="\e[0m"
else
    greenF=""
    resetFB=""
fi
# Separate compiler flags from program arguments
pre_compiler_flags=(
    "-ggdb"
    "-g3"
    "-fsanitize=address"
    "-Wall"
    )

before_double_dash=()
after_double_dash=()
first_found_double_dash=false
for arg in "$@"; do
    if [ "$arg" = "--" ] && [ "$first_found_double_dash" = false ] ; then
        first_found_double_dash=true
        continue
    fi

    if $first_found_double_dash; then
        after_double_dash+=("$arg")
    else
        before_double_dash+=("$arg")
    fi
done

# Handle the two cases for separating compiler flags and program arguments
# Not use this,` q-gcc right_referenc.cpp -fno-elide-constructors --`  (will not be treated as flag, but prgram args)
# if [ ${#after_double_dash[@]} -ne 0 ]; then 
if [ "$first_found_double_dash" = true ]; then
    # Case 1: -- was found, everything after is program args
    compiler_flags=("${pre_compiler_flags[@]}" "${before_double_dash[@]}")
    program_args=("${after_double_dash[@]}")
else
    # Case 2: -- not found, need to separate compiler flags from program args
    compiler_flags=("${pre_compiler_flags[@]}")
    program_args=()
    
    for arg in "${before_double_dash[@]}"; do
        # If it looks like a compiler flag, add to compiler_flags
        if [[ "$arg" =~ ^-O[0-9s]?$ \
            || "$arg" =~ ^-I \
            || "$arg" =~ ^-L \
            || "$arg" =~ ^-std \
            || "$arg" =~ ^-l ]]; then
            compiler_flags+=("$arg")
        else
            program_args+=("$arg")
        fi
    done
fi

# Generate output filename (replace extension with .out)
output_file="${source_file%.*}.out"

# Build the compilation command
echo -e "${greenF}Compiling${resetFB}: g++ -o \"$output_file\" \"$source_file\" ${compiler_flags[@]}"
g++ -o "$output_file" "$source_file" "${compiler_flags[@]}"

# Check if compilation succeeded
if [ $? -eq 0 ]; then
    echo -e  "${greenF}Running${resetFB}: \"./$output_file\" ${program_args[@]}"
    ./"$output_file" "${program_args[@]}"
else
    echo "Compilation failed"
    exit 1
fi

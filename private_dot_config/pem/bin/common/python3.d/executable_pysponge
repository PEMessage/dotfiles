#!/usr/bin/env python3
import sys

def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <filename>", file=sys.stderr)
        sys.exit(1)
    
    filename = sys.argv[1]
    # Read all input as binary to handle any data without decoding issues
    data = sys.stdin.buffer.read()
    
    # Write the data to the file in binary mode
    with open(filename, 'wb') as f:
        f.write(data)

if __name__ == '__main__':
    main()


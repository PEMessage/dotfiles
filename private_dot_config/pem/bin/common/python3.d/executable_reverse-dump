#!/usr/bin/env python3

import re
import sys
import argparse

def hex_to_bytes(hex_string, no_prefix=False):
    # Determine the regex pattern based on the no_prefix argument
    if no_prefix:
        # Match hex values without the '0x' prefix
        hex_values = re.findall(r'[0-9A-Fa-f]{1,2}', hex_string)
    else:
        # Match hex values with the '0x' prefix
        hex_values = re.findall(r'0x[0-9A-Fa-f]{1,2}', hex_string)

    # Convert hex values to bytes
    byte_array = bytearray(int(hex_value, 16) for hex_value in hex_values)

    return bytes(byte_array)

if __name__ == "__main__":
    # Set up argument parser
    parser = argparse.ArgumentParser(description='Convert hex text to bytes.')
    parser.add_argument('--no-prefix', action='store_true',
                        help='Input hex values without the 0x prefix (e.g., 0A 0B)')

    # Parse arguments
    args = parser.parse_args()

    # Read input from stdin
    input_hex = sys.stdin.read().strip()

    # try to judge if perfix exist or not
    if '0x' not in input_hex:
        args.no_prefix = True

    # Convert hex to bytes
    byte_output = hex_to_bytes(input_hex, no_prefix=args.no_prefix)

    # Print the byte output
    sys.stdout.buffer.write(byte_output)


#!/usr/bin/env python3
import sys
import re
import fileinput

def convert_to_quickfix(line):
    # Match: File "/path/to/file.py", line 123[, in function_name]
    # The "in function_name" part is optional
    pattern = r'File "([^"]+)", line (\d+)(?:, in (.+))?'

    match = re.search(pattern, line)
    if match:
        filename = match.group(1)
        line_num = match.group(2)
        function_name = match.group(3) if match.group(3) else "???"

        return f"{filename}:{line_num}:{function_name}"
    return line

def main():
    try:
        for line in fileinput.input():
            output = convert_to_quickfix(line.rstrip('\n'))
            if output:
                print(output)
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)

if __name__ == "__main__":
    main()

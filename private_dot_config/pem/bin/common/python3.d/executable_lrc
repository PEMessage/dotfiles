#!/usr/bin/env python3
import sys

def calculate_lrc(data):
    """
    Calculate Longitudinal Redundancy Check (LRC) for binary data.
    
    Args:
        data (bytes): Binary data
    
    Returns:
        int: LRC value (0-255)
    """
    lrc = 0
    for byte in data:
        lrc ^= byte
    return lrc

def main():
    # Read binary data from stdin
    data = sys.stdin.buffer.read()
    
    if not data:
        print("Error: No input data provided", file=sys.stderr)
        sys.exit(1)
    
    # Calculate LRC
    lrc = calculate_lrc(data)
    
    # Print results
    print(f"Input size: {len(data)} bytes")
    print(f"LRC (hex):  0x{lrc:02X}")
    print(f"LRC (dec):  {lrc}")
    print(f"LRC (bin):  {lrc:08b}")

if __name__ == "__main__":
    main()

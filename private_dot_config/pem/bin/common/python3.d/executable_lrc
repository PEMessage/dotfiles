#!/usr/bin/env python3
import sys

def calculate_lrc(data):
    """Calculate Longitudinal Redundancy Check (XOR checksum)"""
    lrc = 0
    for byte in data:
        lrc ^= byte
    return lrc

def calculate_checksum(data):
    """Calculate additive checksum (with 8-bit overflow)"""
    checksum = 0
    for byte in data:
        checksum += byte
        checksum &= 0xFF  # Keep only 8 bits
    return checksum

def main():
    # Read binary data from stdin
    data = sys.stdin.buffer.read()

    if not data:
        print("Error: No input data provided", file=sys.stderr)
        sys.exit(1)

    # Calculate both LRC and checksum
    lrc = calculate_lrc(data)
    checksum = calculate_checksum(data)

    # Print comprehensive results
    print(f"Input size: {len(data)} bytes")
    print("\nLRC Results:")
    print(f"  Hex:  0x{lrc:02X}")
    print(f"  Dec:  {lrc}")
    print(f"  Bin:  {lrc:08b}")

    print("\nChecksum Results:")
    print(f"  Hex:  0x{checksum:02X}")
    print(f"  Dec:  {checksum}")
    print(f"  Bin:  {checksum:08b}")

    print("\nCombined (LRC + Checksum):")
    print(f"  Hex:  0x{lrc:02X} 0x{checksum:02X}")
    print(f"  Dec:  {lrc} {checksum}")

if __name__ == "__main__":
    main()

class c:
    GRAY = '\033[90m'      # Bright black (dark gray)
    GREEN = '\033[92m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    YELLOW = '\033[93m'

    PURPLE = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    RESET = '\033[0m'
    UNDERLINE = '\033[4m'



def read_file(filepath: str) -> str:
    """Read and validate JSON file"""
    with open(filepath, 'r') as f:
        data = f.read()
        return data

def write_file(filepath: str, data) -> None:
    """Write data to a file"""
    with open(filepath, 'w') as f:
        f.write(data)

def deep_merge(base, updates):
    for key, value in updates.items():
        if key in base and isinstance(base[key], dict) and isinstance(value, dict):
            deep_merge(base[key], value)
        else:
            base[key] = value
    return base



# ------------------------------
# JQ helper function
# ------------------------------
def run_jq(args: List[str], input_data: Optional[str] = None) -> str:
    """Run jq command and return output"""
    cmd = ['jq'] + args

    try:
        if input_data:
            proc = subprocess.run(cmd, input=input_data,
                                  capture_output=True, text=True, check=True)
        else:
            proc = subprocess.run(
                cmd, capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        print(f"\033[91mjq error: {e.stderr}\033[0m", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print(
            "\033[91mError: jq not found. Please install jq first.\033[0m", file=sys.stderr)
        sys.exit(1)

    return proc.stdout

def extract_fields(data, jq_expr: str) -> List[Tuple[List[str], Any]]:
    jq_cmd = f'paths as $p | select($p | {jq_expr}) | [$p, getpath($p)]'

    output = run_jq(['-c', jq_cmd], json.dumps(data))

    # Parse results
    results = []
    for line in output.strip().split('\n'):
        if line:
            path, value = json.loads(line)
            results.append((path, value))

    return results

def reconstruct_patch(updated_fields: List[Tuple[List[str], Any]]) -> dict:
    if not updated_fields:
        return {}

    # Create jq input
    input_data = '\n'.join(json.dumps([path, value])
                           for path, value in updated_fields)

    # Run jq to reconstruct
    jq_cmd = 'reduce .[] as $item ({}; setpath($item[0]; $item[1]))'
    output = run_jq(["-s", jq_cmd], input_data)

    return json.loads(output)

# ------------------------------
# UI Part
# ------------------------------
def ask_user(options: List[str], current_value: str, query: str = '') -> Any:
    # Convert current_value to string for display if needed
    current_str = str(current_value)

    query = query if query != current_str else ''

    # Create choices list
    choices = options.copy()  # Create a copy to avoid modifying the original
    if current_str in choices:
        choices.remove(current_str)

    # Create display choices with "Keep current" option
    display_choices = [f"Keep current: {current_str}"] + choices

    # Show current value with color
    print(f"Current value: {c.YELLOW}{current_str}{c.RESET}")

    # Use iterfzf for selection
    try:
        selected = iterfzf(
            display_choices,
            multi=False,
            query=query,
            __extra__=['--reverse', '--height=40%']
        )
    except KeyboardInterrupt:
        print(f"{c.RED}Exit by user{c.RESET}")
        sys.exit(1)

    if selected == f"Keep current: {current_str}":
        return current_value

    return selected

def ask_all(fields: List[Tuple[List[str], Any]], options: List[str]) -> dict:
    previous_value = None
    fields_patch = []

    print("=== Interactive Field Selection ===")
    print(f"Found {len(fields)} field(s) to review")

    for i, (path, current_value) in enumerate(fields, 1):
        path_str = '.'.join(str(p) for p in path)

        print(f"{c.GRAY}[{i}/{len(fields)}]{c.RESET}")
        print(f"{c.BOLD}Field: {path_str} {c.RESET}")

        new_value = ask_user(
            options.copy(),  # Copy to avoid modifying original
            current_value,
            previous_value if previous_value else ''
        )
        previous_value = new_value

        if new_value != current_value:
            fields_patch.append((path, new_value))
            print(f"{c.GREEN}✓ Updated{c.RESET}: {json.dumps(new_value)}")
        else:
            print(f"{c.GREEN}→ Kept current{c.RESET}")

        # Add separator between fields
        if i < len(fields):
            print(c.GRAY + "-" * 50 + c.RESET)

    return fields_patch


# ------------------------------
# main
# ------------------------------
def main(argv):
    parser = create_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return 1

    if args.verbose:
        print(f"Reading: {args.input}")

    data = json.loads(read_file(args.input))

    if args.verbose:
        print(f"Processing with jq expression: {args.jq_expr}")

    fields = extract_fields(data, args.jq_expr)

    if not fields:
        print("No matching fields found")
        return

    fields_patch = ask_all(fields, args.options if not callable(args.options) else args.options())

    patch = reconstruct_patch(fields_patch)

    if not patch:
        print("No updates to apply")
        return

    result_str = json.dumps(deep_merge(data.copy(), patch.copy()), indent=2)

    if args.output:
        write_file(args.output, result_str)
    elif args.inplace:
        write_file(args.input, result_str)
    else:
        print(result_str)



if __name__ == "__main__":
    main(sys.argv[1:])





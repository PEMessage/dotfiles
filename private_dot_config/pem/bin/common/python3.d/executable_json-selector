"""
JSON Field Selector - Interactive field selection and modification using jq

Usage:
    selector.py input.json <jq_expr> [--options LIST...] [--output FILE]

Examples:
    selector.py data.json '.[0]? // empty' --output modified.json
    selector.py config.json 'strings' --options "value1" "value2" "value3"
    selector.py data.json '.[] | select(.type=="user")' --options "admin" "guest" --output result.json
"""

import json
import subprocess
import sys
import os
import argparse
from copy import deepcopy
from typing import List, Tuple, Any, Optional

from pyfzf import FzfPrompt
from iterfzf import iterfzf

# ------------------------------
# CLI interface
# ------------------------------
def create_parser() -> argparse.ArgumentParser:
    """Create argument parser"""
    parser = argparse.ArgumentParser(
        description='Interactive JSON field selector and modifier using jq',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )

    arguments = {
        ('input',): {'help': 'Input JSON file'},
        ('--jq_expr',): {'help': 'jq expression to select fields (e.g., ".[]?.name")'},
        ('--options',): {'nargs': '+', 'help': 'List of predefined options to choose from'},
        ('-o', '--output'): {'help': 'Output file'},
        ('-i', '--inplace'): {'action': 'store_true', 'help': 'Modify the input file in-place (conflicts with -o/--output)'},
        ('-v', '--verbose'): {'action': 'store_true', 'help': 'Show verbose output'}
    }

    subparsers = parser.add_subparsers(
        dest='command',
        help='Commands',
        required=False
    )

    # Main command parser (original functionality)
    main_parser = subparsers.add_parser(
        'run',
        help='Run the interactive JSON selector'
    )
    for args, kwargs in arguments.items():
        main_parser.add_argument(*args, **kwargs)

    opencode_preset_parser = subparsers.add_parser(
        'opencode',
        help='opencode preset'
    )

    def opencode_options():
        import subprocess
        result = subprocess.run(['opencode', 'models'], capture_output=True, text=True)
        return result.stdout.strip().split('\n')  # or parse as needed

    opencode_arguments = {
        ('--jq_expr',): {'default': 'contains(["presets"]) and contains(["model"])'},
        ('--options',): {'default': opencode_options},
        ('-i', '--inplace'): {'default': True}
    }
    for args, kwargs in deep_merge(deepcopy(arguments), deepcopy(opencode_arguments)).items():
        opencode_preset_parser.add_argument(*args, **kwargs)


    return parser


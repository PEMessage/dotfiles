class Base:
    # only dataclass will run this, so we could use dataclass api -- fields
    # force type convert to match @dataclass define
    def __post_init__(self):
        def skip_type(T):
            SKIP_TYPE = [
                typing._GenericAlias, # We can't handle 'List[T]'
            ]
            if type(T) in SKIP_TYPE or T in SKIP_TYPE:
                return True
            else:
                return False

        for f in fields(self):
            value = getattr(self, f.name)
            T = getclass(f.type)
            # if skip_type(T):
            #     return
            if not checktype(value, T):
                setattr(self, f.name, T(value))

    def __setattr__(self, name, value):
        if not is_dataclass(self):
            super().__setattr__(name, value)
            return

        f = next(
            filter(lambda f: f.name == name, fields(self)),
            None
        )
        if f:
            T = getclass(f.type)
            if not checktype(value, T):
                super().__setattr__(name, T(value))
            else:
                super().__setattr__(name, value)



    # if not dataclass, your should override this
    @classmethod
    @binary_data_handler
    def from_binary(cls, bio, ctx_upper=None):
        m = {}
        ctx = {
            'parrent': ctx_upper,
            'm': m,
        }
        for f in fields(cls):
            m[f.name] = getclass(f.type).from_binary(bio, ctx)
        return cls(**m)

    # if not dataclass, your should override this
    @classinstancemethod
    def to_binary(cls, self) -> bytes:
        bio = BytesIO()
        for f in fields(cls):
            field_type = getclass(f.type)
            value = getattr(self, f.name)
            # for List[T]
            if type(f.type) ==  typing._GenericAlias:
                contentor_type = getclass(f.type.__args__[0])
                for i in value:
                    bio.write(contentor_type.to_binary(i))
            else:
                bio.write(field_type.to_binary(value))
        return bio.getvalue()

    # if not dataclass, your should override this
    @classinstancemethod
    def get_size(cls, self=None):
        size = 0
        for f in fields(cls):
            field_type = getclass(f.type)
            size = size + field_type.get_size(self)
        return size





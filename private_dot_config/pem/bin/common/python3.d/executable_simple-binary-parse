import re
import pprint
import struct
import json
from dataclasses import dataclass, fields, asdict
from io import BytesIO

# ==========================================
# Some Helper function
# ==========================================
def getclass(cla):
    if isinstance(type(cla), type):
        return cla
    elif isinstance(type(cla), str):
        match = re.fullmatch(r'(\w+)\[(\d+)\]', cla)
        # Handle __class_getitem__ like 'CharType[32]'
        if match:
            base_name, param = match.groups()
            base_cls = globals()[base_name]
            return base_cls[int(param)]
        else:
            return globals()[cla]
    else:
        raise ValueError("Can't Handle it")

def binary_data_handler(func):
    def wrapper(cls, binary_data, *args, **kwargs):
        if isinstance(binary_data, bytes):
            bio = BytesIO(binary_data)
        else:
            bio = binary_data
        return func(cls, bio, *args, **kwargs)
    return wrapper

def print_dataclass(obj):
    print(json.dumps(
        asdict(obj),
        indent=2
    ))



# ==========================================
# Main Class
# ==========================================
class Base:
    @classmethod
    @binary_data_handler
    def from_binary(cls, bio, ctx_upper=None):
        m = {}
        ctx = {
            'parrent': ctx_upper,
            'm': m,
        }
        for f in fields(cls):
            m[f.name] = getclass(f.type).from_binary(bio, ctx)
        return cls(**m)

    @classmethod
    def to_binary(cls, self) -> bytes:
        bio = BytesIO()
        for f in fields(self):
            field_type = getclass(f.type)
            value = getattr(self, f.name)
            bio.write(field_type.to_binary(value))
        return bio.getvalue()

    @classmethod
    def get_size(cls, self=None):
        size = 0
        for f in fields(cls):
            field_type = getclass(f.type)
            size = size + field_type.get_size(self)
        return size
        




# ==========================================
# Some Helper function built on pervious define
# ==========================================
def make_struct_type(fmt: str):
    class StructType(Base):
        @classmethod
        @binary_data_handler
        def from_binary(cls, bio: BytesIO, _ctx) -> int:
            return struct.unpack(fmt, bio.read(struct.calcsize(fmt)))[0]

        @classmethod
        def to_binary(cls, value: int) -> bytes:
            return struct.pack(fmt, value)
        @classmethod
        def get_size(cls, _self):
            return struct.calcsize(fmt)

    return StructType

def make_char_type(fmt: str, encoding: str):
    class CharType(Base):
        @classmethod
        @binary_data_handler
        def from_binary(cls, bio: BytesIO, _ctx) -> int:
            return struct.unpack(fmt, bio.read(struct.calcsize(fmt)))[0].decode(encoding)

        @classmethod
        def to_binary(cls, value: int) -> bytes:
            return struct.pack(fmt, value)

        @classmethod
        def get_size(cls, _self):
            return struct.calcsize(fmt)
    return CharType

class char:
    @classmethod
    def __class_getitem__(cls, size: int):
        fmt = f"{size}s"
        return make_char_type(fmt, 'ascii')


u8 = make_struct_type('<B')
uchar = u8

i8 = make_struct_type('<b')
u16 = make_struct_type('<H')
i16 = make_struct_type('<h')

u32 = make_struct_type('<I')
ulong = u32
uint = u32

i32 = make_struct_type('<i')
u64 = make_struct_type('<Q')
i64 = make_struct_type('<q')

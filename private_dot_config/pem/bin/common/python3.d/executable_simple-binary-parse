def set_nested_value(obj, key_path, value):
    parts = [re.match(r'([^\[\]]+)(?:\[(\d+)\])?', p).groups() 
             for p in key_path.split('.')]
    
    current = obj
    for (key, idx) in parts[:-1]:
        # Navigate through containers
        current = current[int(key)] if isinstance(current, list) else (
            current[key] if isinstance(current, dict) else getattr(current, key)
        )
        # Handle list indexing
        if idx is not None:
            current = current[int(idx)]
    
    # Process final assignment
    last_key, last_idx = parts[-1]
    container = current
    
    if last_idx is not None:
        container = container[int(last_idx)]
    
    # Type-aware assignment
    if isinstance(container, dict):
        if last_key not in container:
            raise KeyError(f"Key '{last_key}' not found")
        target_type = type(container[last_key])
        container[last_key] = target_type(value)
    else:
        if not hasattr(container, last_key):
            raise AttributeError(f"Attribute '{last_key}' not found")
        target_type = type(getattr(container, last_key))
        setattr(container, last_key, target_type(value))


def checktype(obj, hint):
    # Handle Optional/Union types (e.g., Optional[int] = Union[int, None])
    if get_origin(hint) is Union:
        return any(checktype(obj, arg) for arg in get_args(hint))
    
    # For non-generic types, use direct isinstance check
    if not (origin := get_origin(hint)):
        return isinstance(obj, hint)
    
    # Check if the object matches the base type (e.g., list, dict)
    if not isinstance(obj, origin):
        return False
    
    # Handle generic types (e.g., list[int], dict[str, int])
    type_args = get_args(hint)
    
    if origin is list:
        # Check all elements in the list
        return all(checktype(item, type_args[0]) for item in obj)
    
    elif origin is dict:
        # Check keys and values in the dictionary
        key_type, value_type = type_args
        return all(
            checktype(key, key_type) and checktype(value, value_type)
            for key, value in obj.items()
        )
    
    elif origin is tuple:
        # Handle tuples (fixed-length or variable-length)
        if len(type_args) == 2 and type_args[1] is Ellipsis:
            # tuple[int, ...] (variable-length)
            return all(checktype(item, type_args[0]) for item in obj)
        else:
            # tuple[int, str] (fixed-length)
            return len(obj) == len(type_args) and all(
                checktype(item, arg) for item, arg in zip(obj, type_args)
            )
    
    # Add support for other generic types (e.g., set, frozenset) here
    return True  # Fallback for unsupported generics

def getclass(cla):
    # deal with normal case, field.type already is class object
    if type(cla) is type:
        return cla
    # deal with special case, python3 runtime sevice can't find classtype
    # for example 'char[16]', manully parse it, and even generate type at this time
    elif isinstance(cla, typing._GenericAlias):
        return cla
    elif isinstance(cla, str):
        match = re.fullmatch(r'(\w+)\[(\d+)\]', cla)
        # Handle __class_getitem__ like 'CharType[32]'
        if match:
            base_name, param = match.groups()
            base_cls = globals()[base_name]
            return base_cls[int(param)]
        else:
            return globals()[cla]
    else:
        raise ValueError("Can't Handle it")

def binary_data_handler(func):
    def wrapper(cls, binary_data, *args, **kwargs):
        if isinstance(binary_data, bytes):
            bio = BytesIO(binary_data)
        else:
            bio = binary_data
        return func(cls, bio, *args, **kwargs)
    return wrapper

def print_dataclass(obj):
    print(json.dumps(
        asdict(obj),
        indent=2
    ))

# Credit: https://stackoverflow.com/questions/48808788/make-a-method-that-is-both-a-class-method-and-an-instance-method
class classinstancemethod:
    def __init__(self, method, instance=None, owner=None):
        self.method = method
        self.instance = instance
        self.owner = owner

    def __get__(self, instance, owner=None):
        return type(self)(self.method, instance, owner)

    def __call__(self, *args, **kwargs):
        instance = self.instance
        if instance is None:
            if not args:
                instance = None
            else:
                instance, args = args[0], args[1:]

        cls = self.owner
        return self.method(cls, instance, *args, **kwargs)





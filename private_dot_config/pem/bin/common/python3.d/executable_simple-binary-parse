@cache
def make_int_type(fmt: str):
    class IntType(int, Base):

        @classmethod
        @binary_data_handler
        def from_binary(cls, bio: BytesIO, _ctx) -> Self:
            data = bio.read(struct.calcsize(fmt))
            return cls(
                struct.unpack(fmt, data)[0]
            )

        @classinstancemethod
        def to_binary(cls, self: Self) -> bytes:
            return struct.pack(fmt, self)
        @classinstancemethod
        def get_size(cls, _self):
            return struct.calcsize(fmt)

    return IntType

@cache
def make_char_type(fmt: str, encoding: str):
    class CharType(str, Base):

        @classmethod
        @binary_data_handler
        def from_binary(cls, bio: BytesIO, _ctx) -> Self:
            data = bio.read(struct.calcsize(fmt))
            return cls(
                struct.unpack(fmt, data)[0].decode(encoding)
            )

        @classinstancemethod
        def to_binary(cls, self: Self) -> bytes:
            return struct.pack(fmt, self.encode(encoding))

        @classinstancemethod
        def get_size(cls, _self):
            return struct.calcsize(fmt)
    return CharType

class char:
    @classmethod
    def __class_getitem__(cls, size: int):
        fmt = f"{size}s"
        return make_char_type(fmt, 'ascii')



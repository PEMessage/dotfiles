#!/bin/bash

# Check if an argument was provided
if [ $# -eq 0 ]; then
    echo "Error: No executable specified"
    echo "Usage: $0 <executable>"
    exit 1
fi


# Build properly quoted arguments
cmd="TermdebugEx"
for arg in "$@"; do
    # Check if argument contains spaces
    if [[ "$arg" =~ [[:space:]] ]]; then
        # Escape single quotes and wrap in quotes
        arg="${arg//\'/\'\\\'\'}"
        cmd="$cmd '$arg'"
    else
        cmd="$cmd $arg"
    fi
done

# Run vim with TermdebugEx command
# echo vim -c "---$cmd---"
exec vim -c "$cmd"

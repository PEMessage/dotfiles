format_sessions() {
    awk -F'\t' -v home="$HOME" "{
        path = \$4
        gsub(home, \"~\", path)
        print $FMT_NONE \$1 $FMT_NONE \"\t\" $FMT_TITLE \$2 $FMT_RESET \"\t\" $FMT_TIME \$3 $FMT_RESET \"\t\" $FMT_NONE path
    }"
}


# Get sessions from database
list_sessions() {
    opencode db "SELECT id, title, datetime(time_updated / 1000, 'unixepoch'), directory FROM session WHERE title NOT LIKE '%subagent)' ORDER BY time_updated DESC" | tail -n +2 | format_sessions
}

# Interactive selection with fzf
interactive_select() {
    local preview_window
    if [ "${COLUMNS:-80}" -lt 80 ]; then
        preview_window="down:50%"
    else
        preview_window="right:50%"
    fi

    # TODO: better preview
    # opencode db "SELECT data FROM part WHERE session_id='ses_2dbb6b6a8ffeqtzaB47x5BPWBT' AND json_extract(data, '$.type') = 'text' ORDER BY time_updated" --format json |
    # jq -r '.[] | .data | fromjson | if .time != null then "Agent: " + .text else "User: " + .text end' |
    # sed -e 's/^Agent:/\x1b[0m---\n\x1b[32mAgent:/' -e 's/^User:/\x1b[0m---\n\x1b[36mUser:/'


    fzf --ansi \
        --delimiter='\t' \
        --with-nth="{2} {3} {4}" \
        --preview="opencode db \"SELECT * FROM session WHERE id={1}\" --format=json" \
        --preview-window="$preview_window" \
        --exit-0 \
        --scheme history
}

expand_path() {
    local path="$1"
    if [[ "$path" == "~"* ]]; then
        path="${HOME}${path:1}"
    fi
    echo "$path"
}


main() {
    local selected
    selected="$(list_sessions | interactive_select)"
    session_id="$(echo "$selected" | cut -f 1 -d $'\t')"
    directory="$(echo "$selected" | cut -f 4 -d $'\t')"

    if [ -n "$session_id" ]; then
        echo "Select session: $session_id"
        echo "Change dir to: $directory"
        cd "$(expand_path "$directory")"
        opencode -s "$session_id"
    else
        echo "No session selected" >&2
        exit 1
    fi
}

main "$@"

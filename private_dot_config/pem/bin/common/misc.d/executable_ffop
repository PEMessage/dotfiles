#!/usr/bin/env bash

set -eu

export LC_ALL=C

# Color support
if [ -t 1 ]; then
    FFOP_COLORS="always"
else
    FFOP_COLORS="never"
fi

# ANSI color codes
if [ "$FFOP_COLORS" = "always" ]; then
    COLOR_ID='\033[1;36m'      # Cyan bold
    COLOR_TITLE='\033[0m'       # Default (no color)
    COLOR_TIME='\033[1;32m'     # Green bold
    COLOR_RESET='\033[0m'
    COLOR_NONE=''

    FMT_ID='"\033[1;36m"'
    FMT_TITLE='"\033[0m"'
    FMT_TIME='"\033[1;32m"'
    FMT_RESET='"\033[0m"'
    FMT_NONE='""'
else
    COLOR_ID=''
    COLOR_TITLE=''
    COLOR_TIME=''
    COLOR_RESET=''
    COLOR_NONE=''

    FMT_ID='""'
    FMT_TITLE='""'
    FMT_TIME='""'
    FMT_RESET='""'
    FMT_NONE='""'
fi


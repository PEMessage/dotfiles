#!/bin/sh


runcmd() {
    echo "Runing: $*"
    "$@"
}
git_config_global() {
    key="$1"
    value="$2"

    curvalue="$(git config --global --get-all "$key")"
    
    if [ "$curvalue" = "$value" ] ; then
        return 0
    elif [ -z "$curvalue" ] ; then
        true
    else 
        runcmd git config --global --unset-all "$key"
    fi
    runcmd git config --global "$key" "$value"
}
 
git_config_global branch.sort -committerdate
git_config_global column.ui auto
git_config_global fetch.writeCommitGraph true
git_config_global log.date iso-local
git_config_global diff.tool vimdiff
# git_config_global core.fsmonitor true

git_config_global alias.pk cherry-pick
git_config_global alias.ck checkout
git_config_global alias.co checkout
git_config_global alias.fw 'merge --ff-only'
git_config_global alias.re 'remote -v'
git_config_global alias.top 'rev-parse --show-toplevel'
git_config_global alias.st 'status --short --branch'
git_config_global alias.lst 'status --short --branch -- .'
git_config_global alias.lg 'log --oneline --graph'
git_config_global alias.di 'diff'
git_config_global alias.dis 'diff --staged'
git_config_global alias.dfs 'diff --staged'
git_config_global alias.ddf 'difftool --ignore-submodules --dir-diff --no-symlinks --tool=dirdiff'
git_config_global alias.nddf 'difftool --ignore-submodules --dir-diff --no-symlinks --tool=ndirdiff'
git_config_global difftool.dirdiff.cmd 'dirdiff $LOCAL $REMOTE'
git_config_global difftool.ndirdiff.cmd 'ndirdiff $LOCAL $REMOTE'
git_config_global difftool.xxd.cmd "bash -c 'vimdiff <(xxd \$1) <(xxd \$2)' -- \$LOCAL \$REMOTE"
git_config_global alias.rflog 'reflog --date=format:'"'"'%y-%m-%d %H:%M'"'"
git_config_global alias.contain \
    '!func() { head=HEAD ; [ "$2" ] && head="$2" ; git merge-base --is-ancestor $1 $head ; } ; func'
git_config_global alias.fbr  \
    '!func() { remote=$1 ; branch=$2 ; git fetch $remote $branch:refs/remotes/$remote/$branch ; } ; func'

# Credit: https://stackoverflow.com/questions/8587536/is-there-any-way-to-continue-git-clone-from-the-point-where-it-failed
git_config_global alias.clone-init 'clone --filter=blob:none'
git_config_global alias.clone-continue 'rev-list --objects --all'
# git_config_global alias.ftag  \
#     '!func() { remote=$1 ; tag=$2 ; git fetch $remote $branch:refs/tags/$tag ; } ; func'
# Credit: https://stackoverflow.com/questions/45338495/fetch-a-single-tag-from-remote-repository
git_config_global alias.ftag  \
    '!func() { remote=$1 ; tag=$2 ; git fetch $remote tag $tag --no-tags ; } ; func'
git_config_global alias.showtool \
    '!showci () { rev=${1:-HEAD}; git difftool $rev~1 $rev; }; showci $1'


# From: https://stackoverflow.com/questions/3515597/add-only-non-whitespace-changes
git_config_global alias.addnw \
   '!sh -c '"'"'git diff -U0 -w --no-color --src-prefix=a/ --dst-prefix=b/ "$@" | git apply --cached --ignore-whitespace --unidiff-zero -'"'"

# state of skip
git_config_global alias.sk '!f() { [ "$#" != 0 ] && cd "${GIT_PREFIX:-.}" ;  unset GIT_DIR ; unset GIT_PREFIX ; git ls-files -t "$@" | grep ^S --color=always; }; f'
# if GIT_DIR set, git ls-files will force to use git root dir as relative path, so manually unset it
git_config_global alias.lsk '!f() { cd "${GIT_PREFIX:-.}" ; unset GIT_DIR ; unset GIT_PREFIX ; git ls-files -t "$@" | grep ^S --color=always; }; f'
git_config_global alias.skip 'update-index --skip-worktree'
git_config_global alias.noskip 'update-index --no-skip-worktree'


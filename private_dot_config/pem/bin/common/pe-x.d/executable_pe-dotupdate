#!/bin/sh
GREEN='\e[092m'
STOP='\e[0m'
temp=$(chezmoi source-path)


DO_ADD=1

GIT_ADD_OPT=""
for x in "$@"
do
    if [ "$x" = "-d" ] ; then 
        cd $temp
        chezmoi re-add
        git add .
        git diff --staged
        cd -
        exit 0
    fi
    if [ "$x" = '-s' ]; then
        DO_ADD=0
    fi
    if [ "$x" = '-i' ]; then
        GIT_ADD_OPT="$GIT_ADD_OPT -i"
    fi
done



echo "${GREEN}INFO${STOP}: ""chezmoi re-add all trackfile"
cd ~
if [ "$DO_ADD" = 1 ] ; then
    chezmoi re-add
fi


echo "${GREEN}INFO${STOP}: ""Add File to source"
# exit
cd $temp
if [ "$DO_ADD" = 1 ] ; then
    git add $GIT_ADD_OPT .
fi

echo "${GREEN}INFO${STOP}: ""Are you sure commit with this change?"
if [ -z "$1" ]; then
    MEG="Update time: "`date '+%Y-%m-%d %H:%M'`
else
    MEG="$*"
fi
echo
git status --short --branch
echo
echo "${GREEN}Commit message${STOP}:"
echo "    $MEG"
echo

while true; do
    echo "Are you sure to commit?"
    read -p "pls input (y) to continue: " input
    if [ "$input" = "y" ]; then
        break
    fi
done

echo
echo "${GREEN}INFO${STOP}: ""OK, now commit "
echo
git commit -m "$MEG"
git log HEAD -n1 --stat --oneline


echo
echo "${GREEN}INFO${STOP}: ""Push to git"
echo
while true; do
    echo "Are you sure to push?"
    read -p "pls input (y) to continue: " input
    if [ "$input" = "y" ]; then
        break
    fi
done
echo
echo "${GREEN}INFO${STOP}: ""OK, now commit "
echo
git push

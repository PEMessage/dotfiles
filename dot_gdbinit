import os
import subprocess
import sys

class PlugBootStrap(gdb.Command):
    """Update or install the gdbplug.py plugin"""
    def __init__(self):
        super(PlugBootStrap, self).__init__("update-plug", gdb.COMMAND_USER)

    def invoke(self, arg, from_tty):
        self.bootstrap(force_update=True)

    def bootstrap(self, force_update=False):
        # Path configurations
        plugin_dir = os.path.expanduser(os.path.join("~", ".config", "gdb"))
        plugin_path = os.path.join(plugin_dir, "gdbplug.py")
        raw_plugin_url = "https://raw.githubusercontent.com/PEMessage/gdbplug/main/gdbplug.py"

        if not os.path.exists(plugin_path) or force_update:
            print("Installing gdbplug...")
            try:
                os.makedirs(plugin_dir, exist_ok=True)
                subprocess.run([
                    "curl", "-fLo", plugin_path,
                    "--create-dirs", raw_plugin_url
                    ], check=True)
                print("Success! Reloading plugin...")
            except Exception as e:
                print(f"Installation failed: {e}")
                sys.exit(1)
        gdb.execute("source {}".format(plugin_path))
PlugBootStrap().bootstrap()
end


